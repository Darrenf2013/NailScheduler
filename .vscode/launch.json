{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run NailScheduler",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "env": {
                "FLASK_ENV": "development",
                "FLASK_DEBUG": "1"
            },
            "python": "${workspaceFolder}/.venv/bin/python"
        }
    ]
}
